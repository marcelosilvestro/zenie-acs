# Modelo do .env. O install.sh cria e preenche o .env a partir deste arquivo (segredos aleatórios, endereços
# e redes perguntados na instalação). Para instalar à mão: copie para .env e ajuste. O .env NUNCA vai para o git.

# --- Versões ---
GENIEACS_VERSION=1.2.16
NODE_VERSION=22
# Mongo >= 5 exige CPU com AVX. Se a VM não tiver, use mongo:4.4
# (o install.sh detecta e ajusta sozinho).
MONGO_IMAGE=mongo:7.0

# --- Segredos ---
# Gere com: openssl rand -hex 32
GENIEACS_UI_JWT_SECRET=troque-por-um-segredo-aleatorio

# --- Rede ---
# IP da VM que as CPEs alcançam (usado nas URLs de download de firmware).
GENIEACS_FS_HOSTNAME=192.168.0.10
# Onde publicar CWMP (7547) e FS (7567). 0.0.0.0 = todas as interfaces da VM.
CWMP_BIND_ADDR=0.0.0.0
# Onde publicar NBI (7557, SEM autenticação) e UI (3000).
# 127.0.0.1 = só a própria VM (acesse via túnel SSH). Para liberar na LAN interna,
# coloque o IP interno da VM. NUNCA exponha à internet.
ADMIN_BIND_ADDR=127.0.0.1

# --- Zenie (painel NOC) ---
# IP ou nome pelo qual o NOC acessa o painel (vai no certificado HTTPS autoassinado).
ZENIE_PUBLIC_HOST=192.168.0.10
# Onde publicar o painel (443/80). Use o IP da rede interna; NUNCA exponha à internet sem necessidade.
ZENIE_BIND_ADDR=0.0.0.0

# --- Usado pelo scripts/genieacs_sync.py ---
GENIEACS_NBI_URL=http://127.0.0.1:7557
GENIEACS_UI_URL=http://127.0.0.1:3000
# Usuário da UI com permissão de escrita em "config" (só necessário para importar ui-config).
GENIEACS_UI_USERNAME=admin
GENIEACS_UI_PASSWORD=

# Teste de conectividade (ping feito pelo equipamento): IP da "Internet" e até 4 nomes, resolvidos pelo DNS do
# próprio equipamento (se só os nomes falham, o problema é de DNS).
ZENIE_PING_INTERNET=8.8.8.8
ZENIE_PING_NAMES=google.com.br whatsapp.com

# Modo homologação (só no servidor de testes): libera edição do catálogo de modelos.
ZENIE_HOMOLOGATION=false

# Chave que cifra os segredos guardados no banco (senha do ACS, senhas de OLT). Gerada pelo install/update;
# NUNCA troque: os segredos já gravados ficariam ilegíveis. Vai no backup junto com este arquivo.
ZENIE_SECRET_KEY=

# Módulo OLT: máximo de ONUs por lote de "Ativar TR-069" (ondas pequenas; 1 a 100).
ZENIE_TR069_BATCH_MAX=10
# Atualização pelo painel (Configurações > Atualização): "releases" = só versões marcadas (vX.Y.Z), para produção;
# "main" = último commit do ramo main (servidor de testes).
ZENIE_UPDATE_CHANNEL=releases
# Túnel Cloudflare: gravados pela tela Configurações > Túnel Cloudflare (agente zenie-hostd). Não edite à mão.
ZENIE_TUNNEL_TOKEN=
COMPOSE_PROFILES=
# Eventos dos equipamentos (aba Eventos): dias de retenção. Apagados automaticamente depois disso.
ZENIE_EVENTS_DAYS=30

# --- Instalador / firewall (deploy/firewall.sh, serviço zenie-firewall) ---
# Nome do provedor.
ZENIE_COMPANY=
# Quem pode falar com o ACS (7547/7567). "any" (padrão) = qualquer origem: o filtro por IP fica no firewall do
# provedor (CPEs com IP público, CGNAT, vários provedores). Ou uma lista de redes, separadas por espaço.
ZENIE_CWMP_ALLOW=any
# Quem pode abrir o painel (443/80). "any" (padrão) = qualquer origem: o filtro por IP fica no firewall do
# provedor. Ou uma lista de redes, separadas por espaço (ex.: 10.0.0.0/8 100.64.0.0/10).
ZENIE_PANEL_ALLOW=any
# Fuso horário do servidor.
TZ=America/Sao_Paulo
