# Respostas para instalação sem perguntas:  sudo ./install.sh --config deploy/respostas.env
# (copie este arquivo, ajuste e passe no --config; não é executado, só lido)

# Nome do provedor (aparece no painel)
ZENIE_COMPANY=Minha Fibra
# Endereço (IP ou nome) que as CPEs usam para chegar a este servidor: vira o ACS URL http://<isto>:7547/
ACS_HOST=10.0.0.10
# Quem pode falar com o ACS (CWMP 7547 e download de firmware 7567): any = qualquer origem (o filtro fica no
# firewall do provedor), ou uma lista de redes (ex.: 100.64.0.0/10 203.0.113.0/24)
ZENIE_CWMP_ALLOW=any
# Endereço do painel no navegador (vai no certificado autoassinado)
ZENIE_PUBLIC_HOST=10.0.0.10
# Quem pode abrir o painel (443/80): any = qualquer origem (o filtro fica no firewall do provedor), ou uma lista
# de redes (ex.: 10.0.0.0/8 192.168.0.0/16)
ZENIE_PANEL_ALLOW=any
# Fuso horário do servidor
TZ=America/Sao_Paulo
# Usuário administrador do painel (a senha temporária é gerada e mostrada no fim)
ZENIE_ADMIN_USER=admin
# Agendar backup diário? yes / no
BACKUP_CRON=yes
